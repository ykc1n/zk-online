+#ifdef RECOIL_WEB_RENDER
+	// Zero-K uses indexed RLE bitmaps for some 3DO unit textures.
+	// SDL decodes those formats, which stb_image does not implement.
+	if (pixels == nullptr && len >= 2 && buf[0] == 'B' && buf[1] == 'M') {
